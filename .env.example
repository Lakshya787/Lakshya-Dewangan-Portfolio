# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (OPTIONAL)
# ==============================================================================

# GitHub Personal Access Token (OPTIONAL)
# Used server-side only to increase GitHub REST API rate limits from 60 req/hr
# (unauthenticated) to 5,000 req/hr.
# If omitted or left empty, the site seamlessly falls back to public rate limits
# and pinned projects from src/data/pinned-projects.ts without errors.
GITHUB_TOKEN=

# Production site URL for Open Graph and Sitemap generation (OPTIONAL)
# Defaults to https://lakshya-portfolio.vercel.app if omitted.
NEXT_PUBLIC_SITE_URL=https://lakshya-portfolio.vercel.app

